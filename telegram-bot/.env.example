# ============================================================
# BOT DE TELEGRAM - VARIABLES DE ENTORNO
# Copia este archivo como .env y completa con tus datos
# ============================================================

# --- BOT DE TELEGRAM ---
# Token que te dio @BotFather
TELEGRAM_TOKEN=tu_token_aqui

# --- SUPABASE ---
# URL de tu proyecto (ej: https://tusuario.supabase.co)
SUPABASE_URL=tu_url_aqui

# Clave de servicio (Service Key, NO la anónima)
# La encuentras en Supabase → Settings → API → Service Role Key
SUPABASE_KEY=tu_clave_de_servicio_aqui

# URL de Storage (opcional, si usas Supabase Storage)
# Ej: https://tusuario.supabase.co/storage/v1/object/public/imagenes/
SUPABASE_STORAGE_URL=tu_storage_url_aqui

# --- ADMIN ---
# Contraseña para registrarse como admin (/admin* CONTRASEÑA)
ADMIN_PASSWORD=micontraseña123

# --- CONFIGURACIÓN POR DEFECTO ---
# Tiempo global para preguntas (segundos)
TIEMPO_GLOBAL_DEFAULT=30

# Notificar al admin cuando alguien termina (True/False)
NOTIFICAR_ADMIN=True

# Reintentos permitidos por defecto
REINTENTOS_DEFAULT=3

# Tolerancia para respuestas abiertas automáticas (0-100)
TOLERANCIA_ABIERTAS=80

# Tamaño máximo de imágenes en KB (se comprimen a esto)
IMG_COMPRESS_KB=200

# --- SISTEMA ---
# Archivo para respaldos locales (ruta relativa)
BACKUP_FILE=data/respaldos.json

# --- RENDER (opcional, para despliegue) ---
# PUERTO para el servidor web (Render lo asigna automáticamente)
PORT=10000